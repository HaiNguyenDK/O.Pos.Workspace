# Sao chép thành .env.local (đã gitignore) rồi điền giá trị. Xem src/data/api/config.ts.

# mock (mặc định) | graphql — graphql: kích hoạt máy bằng tài khoản Portal của quản lý,
# menu + chi nhánh lấy từ BE passiontech; đơn/bếp/thanh toán/PIN nhân viên tạm mock.
EXPO_PUBLIC_API_MODE=mock

# Gateway BE (GraphQL router + REST auth)
EXPO_PUBLIC_GRAPHQL_URL=https://ogw.passiontech.xyz/graphql
EXPO_PUBLIC_REST_URL=https://ogw.passiontech.xyz/api/v1

# Dự phòng khi máy chưa kích hoạt (bình thường lấy từ bước kích hoạt máy)
EXPO_PUBLIC_TENANT_ID=
EXPO_PUBLIC_BRANCH_ID=

# Nhóm API BE đã ĐỀ XUẤT (docs/pos/pos-be-api-request.md Mục 3) — chỉ có tác dụng khi API_MODE=graphql.
# Danh sách cách nhau bằng dấu phẩy; nhóm nào có tên thì gọi BE thật, còn lại chạy mock. Để trống = tất cả mock.
#   orders        bàn + đơn tại bàn: restaurantServiceTables/RunningOrders/PosOrder, OpenOrder, AddLines, VoidLine, MoveOrder, MergeOrders (3.1)
#   bills         restaurantServiceRequestBill, SplitBill, PosBill, PosBills (3.2)
#   payments      paymentServiceRecordCashPayment, CreatePayment (VietQR qrPayload), GetPayment, CancelPayment, ConfirmPaymentManually (3.4)
#   approvals     REST POST /auth/pos/approve — quản lý duyệt bằng PIN (3.3)
#   pin           REST POST /auth/pos/pin/login — PIN máy dùng chung; token PIN dùng cho mọi request GraphQL (3.3)
#   shifts        restaurantServiceCurrentShift/OpenShift/AddCashMovement/ShiftReport/CloseShift/ListShifts (3.11)
#   notifications notificationServiceListNotifications (đã có trên BE)
# Ví dụ: EXPO_PUBLIC_BE_FEATURES=orders,bills,payments
# Lưu ý: orders/bills/payments/shifts dùng chung dữ liệu phía server — nên bật cùng nhau (bật lẻ thì phần mock không thấy đơn/bill thật).
EXPO_PUBLIC_BE_FEATURES=
