# Sao chép thành .env.local (đã gitignore) rồi điền giá trị. Xem src/data/api/config.ts.

# mock (mặc định) | graphql — graphql: menu + chi nhánh lấy từ BE passiontech, phần còn lại tạm mock.
EXPO_PUBLIC_API_MODE=mock

# Endpoint GraphQL router của BE, vd https://<router-host>/graphql (chờ BE cấp URL dev/staging)
EXPO_PUBLIC_GRAPHQL_URL=

# Tenant (nhà hàng) và chi nhánh của máy
EXPO_PUBLIC_TENANT_ID=
EXPO_PUBLIC_BRANCH_ID=

# CHỈ DEV: access token từ REST portal login + select-tenant. KHÔNG đặt khi build bản phát hành.
EXPO_PUBLIC_DEV_ACCESS_TOKEN=
